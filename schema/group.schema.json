{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Conversion": {
      "additionalProperties": false,
      "description": "読みと変換結果（表記）の組。",
      "properties": {
        "reading": {
          "description": "読み。ひらがなと長音符（ー）のみ。",
          "maxLength": 100,
          "pattern": "^[ぁ-ゖー]+$",
          "title": "Reading",
          "type": "string"
        },
        "surface": {
          "description": "変換結果（表記）。UTF-8 で300バイト以内。",
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff]*[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000])?$",
          "title": "Surface",
          "type": "string"
        },
        "pos": {
          "anyOf": [
            {
              "enum": [
                "名詞",
                "固有名詞",
                "人名",
                "姓",
                "名",
                "組織",
                "地名",
                "品詞なし"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "品詞。省略時はファイルの defaults.pos、それも無ければ「品詞なし」。",
          "title": "Pos"
        }
      },
      "required": [
        "reading",
        "surface"
      ],
      "title": "Conversion",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "description": "ファイル内の語に共通する既定値。",
      "properties": {
        "pos": {
          "anyOf": [
            {
              "enum": [
                "名詞",
                "固有名詞",
                "人名",
                "姓",
                "名",
                "組織",
                "地名",
                "品詞なし"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pos"
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "description": "1つの語（エンティティ）。複数の読み・表記を持てる。",
      "properties": {
        "name": {
          "description": "代表名称。",
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff]*[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000])?$",
          "title": "Name",
          "type": "string"
        },
        "conversions": {
          "items": {
            "$ref": "#/$defs/Conversion"
          },
          "minItems": 1,
          "title": "Conversions",
          "type": "array"
        },
        "sources": {
          "description": "出典。最低1件。",
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "tags": {
          "description": "この語に付けるタグ（英小文字・数字・ハイフン）。ファイルのタグに加わる。",
          "items": {
            "maxLength": 50,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "name",
        "conversions",
        "sources"
      ],
      "title": "Entry",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "語の実在や読みを確認できる出典。",
      "properties": {
        "url": {
          "description": "出典の URL（https）。",
          "maxLength": 2000,
          "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+(?::[0-9]{1,5})?(?:[/?#][^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000]*)?$",
          "title": "Url",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff]*[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "補足（例: 読みの確認箇所）。",
          "title": "Note"
        }
      },
      "required": [
        "url"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "dictionary/ 配下の1ファイル。",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "title": {
      "description": "グループの表示名。",
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff]*[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200b\\u200e-\\u200f\\u2028-\\u2029\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000])?$",
      "title": "Title",
      "type": "string"
    },
    "tags": {
      "description": "このファイルのすべての語に付くタグ（例: 組織）。タグごとに配布物が作られる。",
      "items": {
        "maxLength": 50,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "title",
    "entries"
  ],
  "title": "GroupFile",
  "type": "object"
}
